# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local JSON store (jobs etc.) — replaced by Supabase later
/data/*.json
!/data/*.example.json

# Claude Code per-machine settings — `.claude/settings.json` is shared,
# `.claude/settings.local.json` is per-machine (permission grants etc.)
.claude/settings.local.json
.claude/worktrees/

# Playwright — generated artifacts only (source files are committed)
/playwright-report/
/test-results/
/tests/.auth/
.claude/skills/playwright-skill/
.claude/skills/yuvabe-playwright/

# Local-only docs and migration helpers
/docs/test-automation-sprint.md
/docs/test-sprint-overview.md
/docs/test-plan.md
/supabase/combined_test_migration.sql

playground/

# Generated test report (run pnpm test:report to produce)
/test-report.md
